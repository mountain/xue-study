+def _delta_wins(
+    bundle: binformat.Bundle, numeric_id: int, nodata: int, geometry: ArrayGeometry, executor: ThreadPoolExecutor
+) -> bool:
+    """Say whether the delta chain is the smaller of the two for one array.
+
+    Which predictor a field wants is a property of the field, not of the
+    format: a smooth field codes far smaller as a difference against the
+    frame before it, while a field of moving discontinuities (cloud cover,
+    vertical velocity, the pressure family) codes *larger* that way, because
+    differencing draws an edge on both sides of every feature that moved.
+    The container picks its predictor from a rule (``docs/format.md``,
+    "Encoder rules (v2)": RAW for prate and cref, PREVIOUS for every other
+    linear codebook), and the rule is wrong for several of the fields added
+    since it was written.
+
+    The store is derived, so it does not have to inherit that: both chains
+    decode to the same codes, and the choice is per array. The decision is
+    exact rather than sampled: both chains are compressed for every time
+    chunk, so the winner is the smaller store, not an estimate of it.
+    Sampling was tried and is not good enough — the benefit of differencing
+    depends on the step, and a mixed-cadence run is hourly for most of its
+    chunks and three-hourly for the rest. The first chunk alone decides
+    `rh850` wrong; first, middle and last over-weight the coarse segment and
+    decide `cape`, `htsgw` and `wind10m` wrong; every eighth chunk still
+    decides `rh850` wrong, whose margin is 1.4%. The cost is one extra
+    compression pass over the array, on the pool the build already shares,
+    and the payloads are discarded rather than held.
+    """
+    plain = differenced = 0
+    for time_chunk in range(geometry.time_chunks):
+        blocks = [
+            _pad_block(block, geometry, nodata)
+            for block in _tile_blocks(bundle, numeric_id, geometry, geometry.frames(time_chunk))
+        ]
+        plain += sum(
+            len(payload)
+            for payload in executor.map(
+                lambda block: zstdcli.compress(block.tobytes(), level=ZSTD_LEVEL, checksum=True), blocks
+            )
+        )
+        differenced += sum(
+            len(payload)
+            for payload in executor.map(
+                lambda block: zstdcli.compress(_delta_encode(block).tobytes(), level=ZSTD_LEVEL, checksum=True), blocks
+            )
+        )
+    return differenced < plain
+
+
+def _resolve_delta(
+    mode: bool | str,
+    bundle: binformat.Bundle,
+    numeric_id: int,
+    variable: dict[str, Any],
+    geometry: ArrayGeometry,
+    executor: ThreadPoolExecutor,
+) -> bool:
+    """The codec chain one array gets. ``"auto"`` measures; a RAW variable is
+    never differenced, under any mode, because the bundle stores it RAW and
+    the two files are meant to agree where they can."""
+    if _predictor_name(bundle, numeric_id) != "previous":
+        return False
+    if mode == "auto":
+        return _delta_wins(bundle, numeric_id, variable["quantization"]["nodataCode"], geometry, executor)
+    return bool(mode)
+
+
