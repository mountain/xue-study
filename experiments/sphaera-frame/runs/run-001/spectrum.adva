(module spectrum-frame
  (export spectrum turn-i twice-i conjugate p-after-i i-after-p shear unshear chart-i norm chart-norm old-then-i)
  (def merge (fn ((e1 Real) (o1 Real) (e2 Real) (o2 Real)) (outputs Real Real)
    (frontier (add (use e1) (use e2)) (add (use o1) (use o2)))))
  (def weights0 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale 1/16 (use e)) (scale 3/80 (use o)))))
  (def sample0 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights0 (copy (add (scale 0 (use x)) (scale 4/5 (use y))))) (discard (use z)))))
  (def weights1 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale 1/16 (use e)) (scale 3/80 (use o)))))
  (def sample1 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights1 (copy (add (scale 0 (use x)) (scale -4/5 (use y))))) (discard (use z)))))
  (def weights2 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale 1/16 (use e)) (scale 3/80 (use o)))))
  (def sample2 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights2 (copy (add (scale -4/5 (use x)) (scale 0 (use y))))) (discard (use z)))))
  (def weights3 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale 1/16 (use e)) (scale 3/80 (use o)))))
  (def sample3 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights3 (copy (add (scale 4/5 (use x)) (scale 0 (use y))))) (discard (use z)))))
  (def weights4 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale -1/16 (use e)) (scale 3/80 (use o)))))
  (def sample4 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights4 (copy (add (scale 0 (use x)) (scale 4/5 (use y))))) (discard (use z)))))
  (def weights5 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale -1/16 (use e)) (scale 3/80 (use o)))))
  (def sample5 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights5 (copy (add (scale 0 (use x)) (scale -4/5 (use y))))) (discard (use z)))))
  (def weights6 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale -1/16 (use e)) (scale 3/80 (use o)))))
  (def sample6 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights6 (copy (add (scale -4/5 (use x)) (scale 0 (use y))))) (discard (use z)))))
  (def weights7 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale -1/16 (use e)) (scale 3/80 (use o)))))
  (def sample7 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights7 (copy (add (scale 4/5 (use x)) (scale 0 (use y))))) (discard (use z)))))
  (def weights8 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale 1/16 (use e)) (scale 1/20 (use o)))))
  (def sample8 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights8 (copy (add (scale 0 (use x)) (scale 3/5 (use y))))) (discard (use z)))))
  (def weights9 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale 1/16 (use e)) (scale 1/20 (use o)))))
  (def sample9 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights9 (copy (add (scale 0 (use x)) (scale -3/5 (use y))))) (discard (use z)))))
  (def weights10 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale 1/16 (use e)) (scale 1/20 (use o)))))
  (def sample10 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights10 (copy (add (scale -3/5 (use x)) (scale 0 (use y))))) (discard (use z)))))
  (def weights11 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale 1/16 (use e)) (scale 1/20 (use o)))))
  (def sample11 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights11 (copy (add (scale 3/5 (use x)) (scale 0 (use y))))) (discard (use z)))))
  (def weights12 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale -1/16 (use e)) (scale 1/20 (use o)))))
  (def sample12 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights12 (copy (add (scale 0 (use x)) (scale 3/5 (use y))))) (discard (use z)))))
  (def weights13 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale -1/16 (use e)) (scale 1/20 (use o)))))
  (def sample13 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights13 (copy (add (scale 0 (use x)) (scale -3/5 (use y))))) (discard (use z)))))
  (def weights14 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale -1/16 (use e)) (scale 1/20 (use o)))))
  (def sample14 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights14 (copy (add (scale -3/5 (use x)) (scale 0 (use y))))) (discard (use z)))))
  (def weights15 (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (scale -1/16 (use e)) (scale 1/20 (use o)))))
  (def sample15 (fn ((x Real) (y Real) (z Real)) (outputs Real Real)
    (frontier (call weights15 (copy (add (scale 3/5 (use x)) (scale 0 (use y))))) (discard (use z)))))
  (def spectrum (fn ((u0x Real) (u0y Real) (u0z Real) (u1x Real) (u1y Real) (u1z Real) (u2x Real) (u2y Real) (u2z Real) (u3x Real) (u3y Real) (u3z Real) (u4x Real) (u4y Real) (u4z Real) (u5x Real) (u5y Real) (u5z Real) (u6x Real) (u6y Real) (u6z Real) (u7x Real) (u7y Real) (u7z Real) (u8x Real) (u8y Real) (u8z Real) (u9x Real) (u9y Real) (u9z Real) (u10x Real) (u10y Real) (u10z Real) (u11x Real) (u11y Real) (u11z Real) (u12x Real) (u12y Real) (u12z Real) (u13x Real) (u13y Real) (u13z Real) (u14x Real) (u14y Real) (u14z Real) (u15x Real) (u15y Real) (u15z Real)) (outputs Real Real)
    (call merge (call merge (call merge (call merge (call sample0 (use u0x) (use u0y) (use u0z)) (call sample1 (use u1x) (use u1y) (use u1z))) (call merge (call sample2 (use u2x) (use u2y) (use u2z)) (call sample3 (use u3x) (use u3y) (use u3z)))) (call merge (call merge (call sample4 (use u4x) (use u4y) (use u4z)) (call sample5 (use u5x) (use u5y) (use u5z))) (call merge (call sample6 (use u6x) (use u6y) (use u6z)) (call sample7 (use u7x) (use u7y) (use u7z))))) (call merge (call merge (call merge (call sample8 (use u8x) (use u8y) (use u8z)) (call sample9 (use u9x) (use u9y) (use u9z))) (call merge (call sample10 (use u10x) (use u10y) (use u10z)) (call sample11 (use u11x) (use u11y) (use u11z)))) (call merge (call merge (call sample12 (use u12x) (use u12y) (use u12z)) (call sample13 (use u13x) (use u13y) (use u13z))) (call merge (call sample14 (use u14x) (use u14y) (use u14z)) (call sample15 (use u15x) (use u15y) (use u15z))))))))
  (def turn-i (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (neg (use o)) (id (use e)))))
  (def twice-i (fn ((e Real) (o Real)) (outputs Real Real)
    (call turn-i (call turn-i (use e) (use o)))))
  (def conjugate (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (id (use e)) (neg (use o)))))
  (def p-after-i (fn ((e Real) (o Real)) (outputs Real Real)
    (call conjugate (call turn-i (use e) (use o)))))
  (def i-after-p (fn ((e Real) (o Real)) (outputs Real Real)
    (call turn-i (call conjugate (use e) (use o)))))
  (def shear-body (fn ((e Real) (o1 Real) (o2 Real)) (outputs Real Real)
    (frontier (add (use e) (use o1)) (use o2))))
  (def unshear-body (fn ((e Real) (o1 Real) (o2 Real)) (outputs Real Real)
    (frontier (add (use e) (neg (use o1))) (use o2))))
  (def shear (fn ((e Real) (o Real)) (outputs Real Real)
    (call shear-body (use e) (copy (use o)))))
  (def unshear (fn ((e Real) (o Real)) (outputs Real Real)
    (call unshear-body (use e) (copy (use o)))))
  (def chart-i (fn ((e Real) (o Real)) (outputs Real Real)
    (call shear (call turn-i (call unshear (use e) (use o))))))
  (def norm (fn ((e Real) (o Real)) Real
    (add (mul (copy (use e))) (mul (copy (use o))))))
  (def chart-norm (fn ((e Real) (o Real)) Real
    (call norm (call unshear (use e) (use o)))))
  (def old-only (fn ((e Real) (o Real)) (outputs Real Real)
    (frontier (use e) (discard (use o)) 0)))
  (def old-then-i (fn ((e Real) (o Real)) (outputs Real Real)
    (call turn-i (call old-only (use e) (use o)))))
)
